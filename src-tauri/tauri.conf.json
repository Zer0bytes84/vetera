{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baitari",
  "version": "5.4.2",
  "identifier": "com.baitari.vetera",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "category": "Medical",
    "copyright": "© 2026 Baitari. Tous droits réservés.",
    "shortDescription": "Logiciel vétérinaire local-first",
    "longDescription": "Baitari est une plateforme de gestion vétérinaire 100% locale : dossiers patients, agenda, consultations SOAP, ordonnances, hospitalisation, anesthésie, facturation, sauvegarde chiffrée. Aucune donnée ne quitte votre Mac.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      },
      "infoPlist": "Info.plist"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost https:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/local-ai/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Zer0bytes84/vetera/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMEUwODVBOTBBNTU2NDYKUldSR1ZxV1FXZ2dPV2szL21QYUZQeHY5Z09Jb05sQzRwT0ljNlQ2bzFkR3gyWlUxUWlTZWVsYjYK",
      "windows": {
        "installMode": "passive"
      }
    },
    "sql": {},
    "shell": {
      "open": "(((mailto:\\w+)|(tel:\\w+)|(https?://\\w+)).+|whatsapp://send\\?phone=[0-9]{8,15}(&text=[A-Za-z0-9%._~!*'()-]*)?)"
    }
  }
}
